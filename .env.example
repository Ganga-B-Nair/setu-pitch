# Copy this file to .env and fill in real values before running the app.

# Secret used to sign JWT access tokens (HS256).
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_me_with_generated_hex_secret

# Master Key-Encryption-Key (KEK) used to wrap per-record data encryption
# keys (envelope encryption). MUST be a valid Fernet key.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEK_SECRET=replace_me_with_generated_fernet_key

# Seed credentials for the single hardcoded clinic_staff account.
# Change these before any real demo.
SEED_USERNAME=clinic1
SEED_PASSWORD=changeme123

# Origin the Next.js frontend is served from (for CORS).
FRONTEND_ORIGIN=http://localhost:3000
